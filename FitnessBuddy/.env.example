# Copy this file to `.env` and fill in your own values.
# `.env` is loaded automatically by config.py (via python-dotenv) if present.

# Flask
SECRET_KEY=change-this-to-a-random-secret
FLASK_DEBUG=True
PORT=5000

# IBM Cloud / watsonx.ai (Lite plan)
# 1. Create a "watsonx.ai Runtime" (Machine Learning) Lite service on IBM Cloud
# 2. Open https://dataplatform.cloud.ibm.com -> create a Project -> copy its Project ID
# 3. Create an IBM Cloud IAM API key at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-iam-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_IAM_URL=https://iam.cloud.ibm.com/identity/token
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
WATSONX_VERSION=2023-05-29

# "auto" = use Granite if creds above are set, otherwise use built-in mock AI
# "true" = always use mock AI (no IBM Cloud calls, good for local dev/demo)
# "false" = always call watsonx.ai and raise an error if it fails
USE_MOCK_AI=auto
